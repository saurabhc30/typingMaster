{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typingmeter-matchmaking",
  "main": "src/index.js",
  "compatibility_date": "2026-09-05",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Matchmaker"]
    }
  ]
}
